# ---------------------------------------------------
# Base image with Node and pnpm
# ---------------------------------------------------
FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@11.7.0

WORKDIR /app

# ---------------------------------------------------
# Dependencies stage
# ---------------------------------------------------
FROM base AS deps
WORKDIR /app

# Copy root workspace manifests
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy all workspace package manifests to resolve dependency graph
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY packages/config/package.json ./packages/config/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/database/package.json ./packages/database/
COPY packages/ui/package.json ./packages/ui/
COPY packages/validation/package.json ./packages/validation/

RUN pnpm install --frozen-lockfile

# ---------------------------------------------------
# Builder stage
# ---------------------------------------------------
FROM deps AS builder
WORKDIR /app

# Copy shared configs and source files
COPY tsconfig.base.json ./
COPY packages/contracts ./packages/contracts
COPY packages/ui ./packages/ui
COPY apps/web ./apps/web

# Build arguments for public variables (inlined by Next.js at build time)
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SOCKET_URL

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL \
    NODE_ENV=production

# Build web application and its dependencies
RUN pnpm --filter @elhabak/web... build

# ---------------------------------------------------
# Production runner stage
# ---------------------------------------------------
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Create non-root user
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 nextjs

# Copy built workspace files
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=nextjs:nodejs /app/packages/contracts ./packages/contracts
COPY --from=builder --chown=nextjs:nodejs /app/packages/ui ./packages/ui
COPY --from=builder --chown=nextjs:nodejs /app/apps/web ./apps/web

USER nextjs

WORKDIR /app/apps/web

EXPOSE 3000

# Railway sets PORT at runtime. Next.js start script runs "next start -H 0.0.0.0", honoring PORT.
CMD ["node", "./node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0"]
