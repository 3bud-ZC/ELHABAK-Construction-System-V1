{
  "name": "@elhabak/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsx scripts/prisma.ts generate && tsc -p tsconfig.json",
    "db:generate": "tsx scripts/prisma.ts generate",
    "db:validate": "tsx scripts/prisma.ts validate",
    "db:migrate:dev": "tsx scripts/prisma.ts migrate dev",
    "db:migrate:deploy": "tsx scripts/prisma.ts migrate deploy",
    "db:migrate:apply": "tsx scripts/apply-migrations.ts",
    "db:seed": "tsx scripts/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6"
  }
}
