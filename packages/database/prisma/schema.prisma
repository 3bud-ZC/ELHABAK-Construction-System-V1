generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  ADMIN
  ENGINEER
  ACCOUNTANT
  WORKER
  CLIENT
}

enum ProjectCategory {
  DESIGN
  CONSTRUCTION
  FINISHING
  GENERAL_CONTRACTING
  FURNITURE
  MIXED
}

enum ProjectPhase {
  SITE_INSPECTION
  DESIGN
  PRELIMINARY_ESTIMATION
  EXECUTION
  INITIAL_HANDOVER
  FINAL_HANDOVER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SiteMediaType {
  IMAGE
  VIDEO
}

enum SiteUpdateType {
  PROGRESS
  INSPECTION
  ISSUE
  MATERIAL
  GENERAL
}

enum DesignDiscipline {
  ARCHITECTURAL
  STRUCTURAL
  INTERIOR
  ELECTRICAL
  PLUMBING
  FURNITURE
  RENDERS
  OTHER
}

enum DesignStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum DesignEventType {
  DESIGN_CREATED
  DESIGN_UPDATED
  REVISION_UPLOADED
  SUBMITTED_FOR_REVIEW
  CLIENT_APPROVED
  CLIENT_REJECTED
  COMMENT_ADDED
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  displayName  String
  role         UserRole
  passwordHash String?
  isActive     Boolean             @default(true)
  clientProfile ClientProfile?
  assignments  ProjectAssignment[]
  engineeredProjects Project[]     @relation("ProjectEngineer")
  siteUpdates SiteUpdate[]
  uploadedMedia SiteMedia[]
  uploadedDesignRevisions DesignRevision[]
  designEvents DesignEvent[]
  auditLogs     AuditLog[]
  sessions      AuthSession[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([role])
}

model AuthSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ClientProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  phone     String?
  notes     String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id          String              @id @default(cuid())
  code        String?             @unique
  name        String
  category    ProjectCategory
  phase       ProjectPhase        @default(SITE_INSPECTION)
  status      ProjectStatus       @default(PLANNED)
  progress    Int                 @default(0)
  clientId    String?
  client      ClientProfile?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  engineerId  String?
  engineer    User?               @relation("ProjectEngineer", fields: [engineerId], references: [id], onDelete: SetNull)
  location    String?
  startDate   DateTime?
  targetDate  DateTime?
  notes       String?
  assignments ProjectAssignment[]
  siteUpdates SiteUpdate[]
  media       SiteMedia[]
  designs     DesignItem[]
  designRevisions DesignRevision[]
  auditLogs   AuditLog[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([clientId])
  @@index([engineerId])
  @@index([phase, status])
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model SiteUpdate {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId        String
  author          User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  type            SiteUpdateType @default(GENERAL)
  phase           ProjectPhase?
  progressImpact  Int?
  isClientVisible Boolean        @default(true)
  note            String?
  media           SiteMedia[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, type, createdAt])
  @@index([authorId])
}

model SiteMedia {
  id               String        @id @default(cuid())
  siteUpdateId     String
  siteUpdate       SiteUpdate    @relation(fields: [siteUpdateId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId       String
  uploader         User          @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  mediaType        SiteMediaType
  storagePath      String
  storedFilename   String
  originalFilename String
  mimeType         String
  fileSize         Int
  createdAt        DateTime      @default(now())

  @@index([siteUpdateId])
  @@index([projectId])
  @@index([uploaderId])
}

model DesignItem {
  id                    String           @id @default(cuid())
  projectId             String
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  discipline            DesignDiscipline
  status                DesignStatus     @default(DRAFT)
  currentRevisionNumber Int              @default(1)
  revisions             DesignRevision[]
  events                DesignEvent[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([projectId, updatedAt])
  @@index([projectId, status, discipline])
}

model DesignRevision {
  id               String       @id @default(cuid())
  designId         String
  design           DesignItem   @relation(fields: [designId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionNumber   Int
  status           DesignStatus @default(DRAFT)
  notes            String?
  storagePath      String
  storedFilename   String
  originalFilename String
  mimeType         String
  fileSize         Int
  uploaderId       String
  uploader         User         @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  events           DesignEvent[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([designId, revisionNumber])
  @@index([projectId])
  @@index([uploaderId])
}

model DesignEvent {
  id         String          @id @default(cuid())
  designId   String
  design     DesignItem      @relation(fields: [designId], references: [id], onDelete: Cascade)
  revisionId String?
  revision   DesignRevision? @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     DesignEventType
  comment    String?
  createdAt  DateTime        @default(now())

  @@index([designId, createdAt])
  @@index([revisionId, createdAt])
  @@index([actorId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([projectId])
  @@index([createdAt])
}
