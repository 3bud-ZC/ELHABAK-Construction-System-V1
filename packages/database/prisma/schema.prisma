generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  ADMIN
  ENGINEER
  ACCOUNTANT
  WORKER
  CLIENT
}

enum ProjectCategory {
  DESIGN
  CONSTRUCTION
  FINISHING
  GENERAL_CONTRACTING
  FURNITURE
  MIXED
}

enum ProjectPhase {
  SITE_INSPECTION
  DESIGN
  PRELIMINARY_ESTIMATION
  EXECUTION
  INITIAL_HANDOVER
  FINAL_HANDOVER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SiteMediaType {
  IMAGE
  VIDEO
}

enum SiteUpdateType {
  PROGRESS
  INSPECTION
  ISSUE
  MATERIAL
  GENERAL
}

enum DesignDiscipline {
  ARCHITECTURAL
  STRUCTURAL
  INTERIOR
  ELECTRICAL
  PLUMBING
  FURNITURE
  RENDERS
  OTHER
}

enum DesignStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum DesignEventType {
  DESIGN_CREATED
  DESIGN_UPDATED
  REVISION_UPLOADED
  SUBMITTED_FOR_REVIEW
  CLIENT_APPROVED
  CLIENT_REJECTED
  COMMENT_ADDED
}

// Milestone 06 - Financial Architecture & Cost Engineering.
// Money model: every monetary amount is stored as an INTEGER in minor currency units
// (1 EGP = 100 minor units). Every quantity is stored as an INTEGER in milli-units
// (1 unit = 1000 milli-units, i.e. up to 3 decimal places). This guarantees exact,
// deterministic totals and balances with no JavaScript floating-point arithmetic.
// See packages/validation/src/money.ts for the shared conversion helpers.
// V1 supports a single project currency (EGP by default) with no FX conversion.
enum BoqUnit {
  M
  M2
  M3
  ITEM
  LOT
}

enum ExpenseCategory {
  MATERIAL
  LABOR
  TRANSPORT
  EQUIPMENT
  SUBCONTRACTOR
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  OTHER
}

enum FinancialRecordStatus {
  ACTIVE
  VOID
}

enum FinancialAttachmentKind {
  EXPENSE
  CLIENT_PAYMENT
  CONTRACTOR_PAYMENT
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  displayName  String
  role         UserRole
  passwordHash String?
  isActive     Boolean             @default(true)
  clientProfile ClientProfile?
  assignments  ProjectAssignment[]
  engineeredProjects Project[]     @relation("ProjectEngineer")
  siteUpdates SiteUpdate[]
  uploadedMedia SiteMedia[]
  uploadedDesignRevisions DesignRevision[]
  designEvents DesignEvent[]
  auditLogs     AuditLog[]
  sessions      AuthSession[]
  financialProfilesUpdated ProjectFinancialProfile[] @relation("FinancialProfileUpdatedBy")
  costEstimatesCreated     CostEstimate[]             @relation("CostEstimateCreatedBy")
  boqItemsCreated          BOQItem[]                  @relation("BOQItemCreatedBy")
  expensesCreated          Expense[]                  @relation("ExpenseCreatedBy")
  clientPaymentsCreated    ClientPayment[]            @relation("ClientPaymentCreatedBy")
  contractorPaymentsCreated ContractorPayment[]       @relation("ContractorPaymentCreatedBy")
  financialAttachmentsUploaded FinancialAttachment[]  @relation("FinancialAttachmentUploadedBy")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([role])
}

model AuthSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ClientProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  phone     String?
  notes     String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id          String              @id @default(cuid())
  code        String?             @unique
  name        String
  category    ProjectCategory
  phase       ProjectPhase        @default(SITE_INSPECTION)
  status      ProjectStatus       @default(PLANNED)
  progress    Int                 @default(0)
  clientId    String?
  client      ClientProfile?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  engineerId  String?
  engineer    User?               @relation("ProjectEngineer", fields: [engineerId], references: [id], onDelete: SetNull)
  location    String?
  startDate   DateTime?
  targetDate  DateTime?
  notes       String?
  assignments ProjectAssignment[]
  siteUpdates SiteUpdate[]
  media       SiteMedia[]
  designs     DesignItem[]
  designRevisions DesignRevision[]
  auditLogs   AuditLog[]
  financialProfile   ProjectFinancialProfile?
  costEstimates      CostEstimate[]
  boqItems           BOQItem[]
  expenses           Expense[]
  clientPayments     ClientPayment[]
  contractorPayments ContractorPayment[]
  financialAttachments FinancialAttachment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([clientId])
  @@index([engineerId])
  @@index([phase, status])
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model SiteUpdate {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId        String
  author          User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  type            SiteUpdateType @default(GENERAL)
  phase           ProjectPhase?
  progressImpact  Int?
  isClientVisible Boolean        @default(true)
  note            String?
  media           SiteMedia[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, type, createdAt])
  @@index([authorId])
}

model SiteMedia {
  id               String        @id @default(cuid())
  siteUpdateId     String
  siteUpdate       SiteUpdate    @relation(fields: [siteUpdateId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId       String
  uploader         User          @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  mediaType        SiteMediaType
  storagePath      String
  storedFilename   String
  originalFilename String
  mimeType         String
  fileSize         Int
  createdAt        DateTime      @default(now())

  @@index([siteUpdateId])
  @@index([projectId])
  @@index([uploaderId])
}

model DesignItem {
  id                    String           @id @default(cuid())
  projectId             String
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  discipline            DesignDiscipline
  status                DesignStatus     @default(DRAFT)
  currentRevisionNumber Int              @default(1)
  revisions             DesignRevision[]
  events                DesignEvent[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([projectId, updatedAt])
  @@index([projectId, status, discipline])
}

model DesignRevision {
  id               String       @id @default(cuid())
  designId         String
  design           DesignItem   @relation(fields: [designId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionNumber   Int
  status           DesignStatus @default(DRAFT)
  notes            String?
  storagePath      String
  storedFilename   String
  originalFilename String
  mimeType         String
  fileSize         Int
  uploaderId       String
  uploader         User         @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  events           DesignEvent[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([designId, revisionNumber])
  @@index([projectId])
  @@index([uploaderId])
}

model DesignEvent {
  id         String          @id @default(cuid())
  designId   String
  design     DesignItem      @relation(fields: [designId], references: [id], onDelete: Cascade)
  revisionId String?
  revision   DesignRevision? @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     DesignEventType
  comment    String?
  createdAt  DateTime        @default(now())

  @@index([designId, createdAt])
  @@index([revisionId, createdAt])
  @@index([actorId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([projectId])
  @@index([createdAt])
}

model ProjectFinancialProfile {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currency           String   @default("EGP")
  contractValueMinor Int?
  updatedById        String?
  updatedBy          User?    @relation("FinancialProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CostEstimate {
  id          String             @id @default(cuid())
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  version     Int                @default(1)
  isCurrent   Boolean            @default(true)
  description String?
  items       CostEstimateItem[]
  createdById String
  createdBy   User               @relation("CostEstimateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([projectId, isCurrent])
  @@index([projectId, version])
}

model CostEstimateItem {
  id             String       @id @default(cuid())
  estimateId     String
  estimate       CostEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description    String
  unit           BoqUnit
  quantityMilli  Int
  unitRateMinor  Int
  lineTotalMinor Int
  note           String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([estimateId, sortOrder])
}

model BOQItem {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code           String
  section        String?
  description    String
  unit           BoqUnit
  quantityMilli  Int
  unitRateMinor  Int
  lineTotalMinor Int
  note           String?
  sortOrder      Int      @default(0)
  createdById    String
  createdBy      User     @relation("BOQItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, sortOrder])
  @@index([projectId, section])
}

model Expense {
  id          String                @id @default(cuid())
  projectId   String
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  description String
  amountMinor Int
  currency    String                @default("EGP")
  expenseDate DateTime
  vendor      String?
  reference   String?
  note        String?
  status      FinancialRecordStatus @default(ACTIVE)
  voidReason  String?
  attachments FinancialAttachment[]
  createdById String
  createdBy   User                  @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([projectId, expenseDate])
  @@index([projectId, category])
  @@index([projectId, status])
}

model ClientPayment {
  id          String                @id @default(cuid())
  projectId   String
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amountMinor Int
  currency    String                @default("EGP")
  paymentDate DateTime
  method      PaymentMethod
  reference   String?
  description String?
  status      FinancialRecordStatus @default(ACTIVE)
  voidReason  String?
  attachments FinancialAttachment[]
  createdById String
  createdBy   User                  @relation("ClientPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([projectId, paymentDate])
  @@index([projectId, status])
}

model ContractorPayment {
  id          String                @id @default(cuid())
  projectId   String
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payee       String
  amountMinor Int
  currency    String                @default("EGP")
  paymentDate DateTime
  method      PaymentMethod
  category    ExpenseCategory?
  reference   String?
  description String?
  status      FinancialRecordStatus @default(ACTIVE)
  voidReason  String?
  attachments FinancialAttachment[]
  createdById String
  createdBy   User                  @relation("ContractorPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([projectId, paymentDate])
  @@index([projectId, status])
}

model FinancialAttachment {
  id                  String                  @id @default(cuid())
  projectId           String
  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind                FinancialAttachmentKind
  expenseId           String?
  expense             Expense?                @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  clientPaymentId     String?
  clientPayment       ClientPayment?           @relation(fields: [clientPaymentId], references: [id], onDelete: Cascade)
  contractorPaymentId String?
  contractorPayment   ContractorPayment?       @relation(fields: [contractorPaymentId], references: [id], onDelete: Cascade)
  storagePath         String
  storedFilename      String
  originalFilename    String
  mimeType             String
  fileSize            Int
  uploadedById         String
  uploadedBy           User                   @relation("FinancialAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt            DateTime               @default(now())

  @@index([projectId])
  @@index([expenseId])
  @@index([clientPaymentId])
  @@index([contractorPaymentId])
}
