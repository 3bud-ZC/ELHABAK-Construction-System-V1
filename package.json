{
  "name": "elhabak-construction-system-v1",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @elhabak/web --filter @elhabak/api dev",
    "build": "pnpm -r --sort build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter \"./packages/*\" build && pnpm -r --sort typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @elhabak/database db:generate",
    "db:validate": "pnpm --filter @elhabak/database db:validate",
    "db:migrate:dev": "pnpm --filter @elhabak/database db:migrate:dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
