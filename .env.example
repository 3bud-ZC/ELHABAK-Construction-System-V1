NODE_ENV=development
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public
DIRECT_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=elhabak_session
SESSION_EXPIRES_DAYS=7
STORAGE_ROOT=storage
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm
DEMO_ADMIN_PASSWORD=replace-with-local-demo-password
DEMO_ENGINEER_PASSWORD=replace-with-local-demo-password
DEMO_ACCOUNTANT_PASSWORD=replace-with-local-demo-password
DEMO_WORKER_PASSWORD=replace-with-local-demo-password
DEMO_CLIENT_PASSWORD=replace-with-local-demo-password
