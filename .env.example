NODE_ENV=development
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public
DIRECT_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public
WEB_ORIGIN=http://localhost:3000
# Optional comma-separated additional trusted web origins (staging frontend or a future custom domain alongside the Railway one)
EXTRA_WEB_ORIGINS=
API_PORT=4000
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=elhabak_session
SESSION_EXPIRES_DAYS=7
STORAGE_ROOT=storage
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm,application/pdf
DEMO_ADMIN_PASSWORD=replace-with-local-demo-password
DEMO_ENGINEER_PASSWORD=replace-with-local-demo-password
DEMO_ACCOUNTANT_PASSWORD=replace-with-local-demo-password
DEMO_WORKER_PASSWORD=replace-with-local-demo-password
DEMO_CLIENT_PASSWORD=replace-with-local-demo-password
# Optional: login/password-change attempts per IP per minute (default 8)
# AUTH_LOGIN_RATE_LIMIT=8
# Optional: all credential attempts per client IP per minute (default 40; an office NAT shares one IP)
# AUTH_LOGIN_IP_RATE_LIMIT=40
# Optional: Chrome/Chromium binary for server-side PDF reports (auto-detected when empty)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Set by the release flow; reported by /api/health (leave empty locally)
# COMMIT_SHA=
# Optional capacity tuning (defaults suit a 4-vCPU host)
# BCRYPT_WORKERS=3
# PDF_CONCURRENCY=2
# PDF_QUEUE=20
# UPLOAD_CONCURRENCY=6
# UPLOAD_QUEUE=50
# Optional: directory scanned by /admin/system/diagnostics for the newest backup
# BACKUP_DIR=/var/www/elhabak/shared/backups
