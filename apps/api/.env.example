NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public
DIRECT_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public
WEB_ORIGIN=http://localhost:3000
# Optional comma-separated additional trusted web origins (staging frontend or a future custom domain alongside the Railway one)
EXTRA_WEB_ORIGINS=
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=elhabak_session
SESSION_EXPIRES_DAYS=7
STORAGE_ROOT=storage
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm,application/pdf
# Optional: login/password-change attempts per IP per minute (default 8)
# AUTH_LOGIN_RATE_LIMIT=8
# Optional: Chrome/Chromium binary for server-side PDF reports (auto-detected when empty)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Set by the release flow; reported by /api/health (leave empty locally)
# COMMIT_SHA=
